{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "tracer-workflow — PR / Review Trust Lifecycle",
    "output": "tracer-workflow-pr-review.lifecycle.html",
    "quality_profile": "showcase",
    "views": [
      {"id": "main-state-cycle", "label": "PR to merge", "focus": ["implementation_in_progress", "pr_open", "unreviewed_head", "checks_pending", "checks_green", "reviewed_exact_sha", "human_merge_ready", "merged"], "note": "The merge path requires current-head CI evidence and a fresh verdict bound to that same head."},
      {"id": "stale-after-push", "label": "Why a push invalidates review", "focus": ["reviewed_exact_sha", "needs_fix", "repair_new_head", "stale_review", "checks_pending", "unreviewed_head"], "note": "A review is a statement about one commit. Any push changes the identity under review and forces a new round."},
      {"id": "stop-states", "label": "Automation stop states", "focus": ["blocked", "needs_human", "human_merge_ready"], "note": "Blocked and needs-human stop automation; a merge-ready state still preserves the human merge gate in the current review contract."}
    ]
  },
  "lanes": [
    {"id": "implementation", "label": "Implementation / Local Work"},
    {"id": "review_record", "label": "GitHub PR + Review Record"},
    {"id": "verification", "label": "Observed Current-Head Verification"},
    {"id": "human_terminal", "label": "Human / Terminal"}
  ],
  "states": [
    {"id": "implementation_in_progress", "type": "start", "label": "Implementation In Progress", "sublabel": "local worktree / commits", "lane": "implementation", "col": 0, "step": "01", "tag": "not yet durable enough"},
    {"id": "pr_open", "type": "active", "label": "PR Open", "sublabel": "Closes #N + evidence bundle", "lane": "review_record", "col": 0, "step": "02", "tag": "durable record"},
    {"id": "unreviewed_head", "type": "waiting", "label": "Unreviewed Current Head", "sublabel": "no valid verdict for headRefOid", "lane": "review_record", "col": 1, "step": "03", "tag": "needs fresh review"},
    {"id": "checks_pending", "type": "waiting", "label": "Checks Pending", "sublabel": "current-head CI settling", "lane": "verification", "col": 1, "tag": "observed state"},
    {"id": "checks_green", "type": "success", "label": "Checks Green", "sublabel": "configured current-head gate satisfied", "lane": "verification", "col": 2, "tag": "not a correctness guarantee"},
    {"id": "stale_review", "type": "neutral", "label": "Stale Review", "sublabel": "verdict SHA ≠ current head", "lane": "review_record", "col": 2, "tag": "do nothing"},
    {"id": "reviewed_exact_sha", "type": "decision", "label": "Reviewed @ Exact SHA", "sublabel": "fresh verdict comment current for head", "lane": "review_record", "col": 3, "step": "04", "tag": "SHA-bound"},
    {"id": "needs_fix", "type": "waiting", "label": "Needs Fix", "sublabel": "current verdict has fix-now findings", "lane": "review_record", "col": 4, "tag": "poller may act"},
    {"id": "repair_new_head", "type": "active", "label": "Repair / New Head", "sublabel": "from-pr-review fixes + push", "lane": "implementation", "col": 3, "tag": "new commit identity"},
    {"id": "blocked", "type": "failure", "label": "Blocked", "sublabel": "red/no coverage · malformed verdict · evidence inconsistency", "lane": "verification", "col": 4, "tag": "automation stops"},
    {"id": "needs_human", "type": "external", "label": "Needs Human", "sublabel": "scope contradiction · judgment · circuit breaker", "lane": "human_terminal", "col": 1, "tag": "hard stop"},
    {"id": "human_merge_ready", "type": "waiting", "label": "Human Merge-Ready", "sublabel": "merge-candidate + gate current for same SHA", "lane": "human_terminal", "col": 3, "step": "05", "tag": "HITL button"},
    {"id": "merged", "type": "success", "label": "Merged", "sublabel": "PR landed / issue closure can be confirmed", "lane": "human_terminal", "col": 4, "step": "06", "tag": "terminal"}
  ],
  "transitions": [
    {"id": "impl-pr", "from": "implementation_in_progress", "to": "pr_open", "label": "push + open/update PR", "variant": "emphasis"},
    {"id": "pr-unreviewed", "from": "pr_open", "to": "unreviewed_head", "label": "current head has no valid verdict"},
    {"id": "unreviewed-checks", "from": "unreviewed_head", "to": "checks_pending", "label": "observe CI for this head", "variant": "security"},
    {"id": "checks-pass", "from": "checks_pending", "to": "checks_green", "label": "configured gate satisfied", "variant": "security"},
    {"id": "green-review", "from": "checks_green", "to": "reviewed_exact_sha", "label": "fresh review posts SHA-bound verdict", "variant": "emphasis"},
    {"id": "review-needs-fix", "from": "reviewed_exact_sha", "to": "needs_fix", "label": "fix-now remains", "variant": "security"},
    {"id": "fix-repair", "from": "needs_fix", "to": "repair_new_head", "label": "from-pr-review", "variant": "emphasis"},
    {"id": "repair-stales", "from": "repair_new_head", "to": "stale_review", "label": "push changes head SHA", "variant": "security"},
    {"id": "stale-checks", "from": "stale_review", "to": "checks_pending", "label": "new head must re-verify", "variant": "dashed"},
    {"id": "stale-unreviewed", "from": "stale_review", "to": "unreviewed_head", "label": "old verdict is void", "variant": "dashed"},
    {"id": "review-ready", "from": "reviewed_exact_sha", "to": "human_merge_ready", "label": "merge-candidate + same-head gate", "variant": "emphasis"},
    {"id": "ready-merge", "from": "human_merge_ready", "to": "merged", "label": "human merge", "variant": "security"},
    {"id": "review-new-push", "from": "reviewed_exact_sha", "to": "stale_review", "label": "any later push invalidates verdict", "variant": "security"},
    {"id": "ready-new-push", "from": "human_merge_ready", "to": "stale_review", "label": "new push revokes readiness", "variant": "security"},
    {"id": "checks-block", "from": "checks_pending", "to": "blocked", "label": "red / missing current-head coverage", "variant": "security"},
    {"id": "review-block", "from": "reviewed_exact_sha", "to": "blocked", "label": "blocked verdict / evidence inconsistency", "variant": "security"},
    {"id": "review-human", "from": "reviewed_exact_sha", "to": "needs_human", "label": "needs-human verdict", "variant": "security"}
  ],
  "cards": [
    {"dot": "cyan", "title": "Review identity rule", "items": ["The PR is not what is approved; one exact head SHA is what is reviewed.", "A later push makes every prior verdict stale without editing or deleting the historical comment.", "Readers compare the verdict head-sha to the PR current head before acting."]},
    {"dot": "rose", "title": "Stop / degraded states", "items": ["Blocked covers missing/failed current-head verification, malformed gate state, or evidence inconsistency.", "Needs Human covers scope/contract judgment and the corrective-round circuit breaker.", "Neither state authorizes an automated fix or merge."]},
    {"dot": "emerald", "title": "Green is evidence, not proof", "items": ["Local command output is preserved as an evidence bundle, not treated as merge readiness.", "Current-head CI/check state is observed independently from the agent's report.", "A green configured gate narrows uncertainty; it does not guarantee overall correctness."]}
  ]
}
