{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "tracer-workflow — End-to-End Durable Workflow",
    "output": "tracer-workflow-e2e.workflow.html",
    "quality_profile": "showcase",
    "views": [
      {"id": "durable-handoffs", "label": "Durable handoffs", "focus": ["issue_filed", "agent_brief", "pr_opened", "verdict"], "note": "Intent, execution evidence, and review outcome are persisted in GitHub before the next disposable worker takes over."},
      {"id": "needs-fix-loop", "label": "Needs-fix loop", "focus": ["review_gate", "verdict", "from_pr_review", "pr_opened", "check_gate"], "note": "A fix push creates a new head and stales the old verdict. New-head checks are evidence for fresh review, not permission to merge."},
      {"id": "merge-preconditions", "label": "Merge preconditions", "focus": ["verdict", "check_gate", "merge"], "note": "Merge requires a current-head merge-candidate verdict and green check-run gate; AFK may auto-land, while HITL requires human merge."}
    ]
  },
  "lanes": [
    {"id": "planning", "label": "Planning / Fresh Review Sessions"},
    {"id": "github", "label": "GitHub Durable Record"},
    {"id": "execution", "label": "Execution"},
    {"id": "verification", "label": "Observed Verification"},
    {"id": "human", "label": "Landing Authority"}
  ],
  "phases": [
    {"id": "shape", "label": "Shape intent", "fromCol": 0, "toCol": 2},
    {"id": "delegate", "label": "Make work executable", "fromCol": 3, "toCol": 4, "variant": "emphasis"},
    {"id": "review", "label": "Review, verify, land", "fromCol": 5, "toCol": 5, "variant": "security"}
  ],
  "mainPath": ["raw_idea", "issue_filed", "from_issue", "pr_opened", "review_gate", "verdict", "check_gate", "merge"],
  "nodes": [
    {"id": "raw_idea", "lane": "planning", "col": 0, "type": "external", "label": "Raw Idea / PRD", "sublabel": "session-local input", "tag": "not yet durable"},
    {"id": "issue_filed", "lane": "github", "col": 1, "type": "database", "label": "Issue filed", "sublabel": "directly or via upstream to-tickets", "tag": "durable scoped intent"},
    {"id": "triage_queue", "lane": "planning", "col": 2, "type": "frontend", "label": "triage-queue (optional)", "sublabel": "incoming, untriaged, or incomplete issues", "tag": "recommendation only"},
    {"id": "agent_brief", "lane": "planning", "col": 3, "type": "frontend", "label": "agent-brief (optional)", "sublabel": "deep single-item triage when needed", "tag": "writes brief; applies label if needed"},
    {"id": "next", "lane": "execution", "col": 3, "type": "backend", "label": "next", "sublabel": "safety stub until #30", "tag": "not a working selector"},
    {"id": "from_issue", "lane": "execution", "col": 4, "type": "backend", "label": "from-issue", "sublabel": "resume worktree · implement smallest safe slice"},
    {"id": "pr_opened", "lane": "github", "col": 4, "type": "database", "label": "PR + Evidence Bundle", "sublabel": "Closes #N · exact commands/output · head SHA", "tag": "durable authored evidence"},
    {"id": "review_gate", "lane": "planning", "col": 5, "type": "security", "label": "@review-gate plugin", "sublabel": "fresh ChatGPT conversation", "tag": "active entry point"},
    {"id": "verdict", "lane": "github", "col": 5, "type": "messagebus", "label": "Verdict Comment", "sublabel": "state + review-round + exact head-sha", "tag": "append-only / SHA-bound"},
    {"id": "from_pr_review", "lane": "execution", "col": 5, "type": "backend", "label": "from-pr-review", "sublabel": "disposition rules → fix-now batch → push", "tag": "needs-fix only"},
    {"id": "check_gate", "lane": "verification", "col": 5, "type": "security", "label": "Check-Run Gate", "sublabel": "current-head checks + docs-only exception or path coverage", "tag": "observed state"},
    {"id": "merge", "lane": "human", "col": 5, "type": "external", "label": "Land / Merge", "sublabel": "AFK autonomous · HITL human", "tag": "authority fixed at issue creation"}
  ],
  "edges": [
    {"id": "idea-to-issue", "from": "raw_idea", "to": "issue_filed", "label": "direct filing or upstream planning", "role": "main"},
    {"id": "issue-to-execute", "from": "issue_filed", "to": "from_issue", "label": "ready-for-agent / complete contract", "role": "main", "variant": "emphasis"},
    {"id": "issue-to-triage", "from": "issue_filed", "to": "triage_queue", "label": "optional triage when needed", "role": "branch"},
    {"id": "triage-to-brief", "from": "triage_queue", "to": "agent_brief", "label": "optional deep triage", "role": "main"},
    {"id": "brief-to-execute", "from": "agent_brief", "to": "from_issue", "label": "durable brief + ready-for-agent when needed", "role": "main", "variant": "emphasis"},
    {"id": "execute-to-pr", "from": "from_issue", "to": "pr_opened", "label": "commit + push + PR", "role": "main", "variant": "emphasis"},
    {"id": "pr-to-review", "from": "pr_opened", "to": "review_gate", "label": "issue + diff + evidence + current SHA", "role": "main", "variant": "security"},
    {"id": "review-to-verdict", "from": "review_gate", "to": "verdict", "label": "append comment @ exact head", "role": "main", "variant": "emphasis"},
    {"id": "verdict-to-gate", "from": "verdict", "to": "check_gate", "label": "merge-candidate on current head", "role": "main", "variant": "security"},
    {"id": "gate-to-merge", "from": "check_gate", "to": "merge", "label": "same-head gate green; apply issue autonomy", "role": "main", "variant": "security"},
    {"id": "needs-fix", "from": "verdict", "to": "from_pr_review", "label": "needs-fix + SHA current", "role": "branch", "variant": "security"},
    {"id": "fix-push", "from": "from_pr_review", "to": "pr_opened", "label": "push new head → prior verdict stale", "role": "return", "variant": "emphasis", "route": "return-left"},
    {"id": "fix-checks", "from": "from_pr_review", "to": "check_gate", "label": "observe new-head checks (evidence only)", "role": "async", "variant": "dashed"},
    {"id": "new-head-rereview", "from": "check_gate", "to": "review_gate", "label": "after a fix push, fresh review still required", "role": "return", "variant": "dashed", "route": "return-left"},
    {"id": "merge-next", "from": "merge", "to": "next", "label": "post-merge selector is a stub", "role": "return", "variant": "dashed", "route": "return-left"}
  ],
  "cards": [
    {"dot": "cyan", "title": "Durability crossings", "items": ["Issues may be filed directly or created through upstream to-tickets.", "Optional triage makes an incomplete issue executable without prior chat memory.", "from-issue converts local implementation into a PR evidence bundle; review-gate converts fresh review into an append-only SHA-bound verdict."]},
    {"dot": "rose", "title": "Needs-fix invalidation loop", "items": ["Only a current-head needs-fix verdict is eligible for an automated fix pass.", "The fix push moves the PR head and voids the prior verdict immediately.", "New-head CI is evidence for the next review; it does not resurrect the stale verdict."]},
    {"dot": "amber", "title": "Selector status", "items": ["next is a safety stub until issue #30.", "It is not a working post-merge issue selector.", "Continue from durable GitHub issue and PR state rather than relying on next."]}
  ]
}
