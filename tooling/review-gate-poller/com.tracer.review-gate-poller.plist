<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd template: replace every REPLACE_WITH_* value before loading. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tracer.review-gate-poller</string>
    <key>ProgramArguments</key>
    <array>
        <string>REPLACE_WITH_BUN_PATH</string>
        <string>REPLACE_WITH_POLLER_PATH</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>RG_REPO</key>
        <string>REPLACE_WITH_OWNER_REPO</string>
        <key>RG_WORKDIR</key>
        <string>REPLACE_WITH_WORKDIR</string>
        <key>TRACER_REVIEWER_LOGINS</key>
        <string>REPLACE_WITH_REVIEWER_LOGIN</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/local/bin</string>
        <key>HOME</key>
        <string>REPLACE_WITH_HOME</string>
    </dict>
    <key>StartInterval</key>
    <integer>60</integer>
    <key>StandardOutPath</key>
    <string>REPLACE_WITH_STATE_DIR/poller.out.log</string>
    <key>StandardErrorPath</key>
    <string>REPLACE_WITH_STATE_DIR/poller.err.log</string>
    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
